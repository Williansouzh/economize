# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# --- Backend .NET ---
FINANCE_API_URL=http://localhost:5000
# Mesmo valor de "Agent:ApiKey" no backend
AGENT_API_KEY=troque-por-uma-chave-aleatoria

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto livre que você também informa no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=meu-token-de-verificacao
# App Secret do app na Meta (valida a assinatura dos webhooks). Recomendado.
WHATSAPP_APP_SECRET=

# --- Várias instâncias ---
# Vazio: histórico, mensagens já vistas e fila ficam em memória (rode só UMA instância).
# Preenchido: tudo no PostgreSQL, e o agente pode ter várias réplicas.
DATABASE_URL=
# Mensagem "processando" há mais que isso (instância caiu) é reassumida por outra instância
PROCESSING_TIMEOUT_SECONDS=300
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/agente

# --- Áudio (Whisper local) e imagens (Tesseract) ---
WHISPER_MODEL=small
TESSERACT_LANG=por
TIMEZONE=America/Sao_Paulo
