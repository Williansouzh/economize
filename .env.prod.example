# Produção (docker-compose.prod.yml). No servidor: cp .env.prod.example .env e preencha.
# Gere as chaves aleatórias com: openssl rand -hex 32

# --- Domínio e HTTPS ---
# Domínio (ou subdomínio) apontado para o IP da VPS, sem https://. Ex.: financas.seudominio.com.br
DOMAIN=
# E-mail para o Let's Encrypt avisar sobre certificados
ACME_EMAIL=
# Pasta do host com sites de OUTROS sistemas desta VPS atrás do mesmo Caddy
# (*.caddy e *.global). Vazio = nenhum. Ver docs/DEPLOY.md, "Outros sistemas na mesma VPS".
EDGE_SITES_DIR=

# --- Segredos da API ---
POSTGRES_PASSWORD=
JWT_KEY=
AGENT_API_KEY=
DEEPSEEK_API_KEY=

# --- Agente / WhatsApp Cloud API ---
DEEPSEEK_MODEL=deepseek-chat
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Obrigatório em produção: sem ele o agente aceita webhooks que não vieram da Meta.
WHATSAPP_APP_SECRET=
WHISPER_MODEL=small
TESSERACT_LANG=por
TIMEZONE=America/Sao_Paulo
PROCESSING_TIMEOUT_SECONDS=300
RECOVERY_MAX_ATTEMPTS=3

# --- Backup ---
BACKUP_KEEP_DAYS=14
# Cópia externa e criptografada (restic). Vazio = desligada. Ex. com Backblaze B2:
#   RESTIC_REPOSITORY=b2:nome-do-bucket:economizze
#   OFFSITE_KEY_ID / OFFSITE_KEY_SECRET = keyID e applicationKey da chave do bucket
# Com S3 ou compatível: RESTIC_REPOSITORY=s3:https://endpoint/bucket/economizze
# Guarde a RESTIC_PASSWORD fora do servidor também: sem ela a cópia não abre.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
OFFSITE_KEY_ID=
OFFSITE_KEY_SECRET=

# --- E-mail (código de "esqueci minha senha") ---
# Qualquer SMTP com STARTTLS. Ex. Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend,
# SMTP_PASSWORD=a chave da API, SMTP_FROM="Economizze <nao-responda@seudominio>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
