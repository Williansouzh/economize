{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZone": "America/Sao_Paulo"
  },
  "RateLimit": {
    "AuthPerMinute": 10,
    "ApiPerMinute": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "ConnectionStrings": {
    "Default": "Data Source=financas.db"
  },
  "Jwt": {
    "Issuer": "Financas.Api",
    "Audience": "Financas.App",
    "Key": "",
    "ExpirationDays": 30
  },
  "Agent": {
    "ApiKey": ""
  },
  "DeepSeek": {
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-chat",
    "ApiKey": ""
  }
}
