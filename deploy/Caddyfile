# Um domínio só, com HTTPS automático (Let's Encrypt):
#   https://DOMAIN/api/*    → API .NET
#   https://DOMAIN/webhook  → agente do WhatsApp (URL cadastrada na Meta)
#   https://DOMAIN/app/     → app Flutter web
#   https://DOMAIN/download → APK publicado (deploy/publish-apk.sh)
#   https://DOMAIN/         → landing page e páginas públicas (site/)
# App web e API ficam na mesma origem, então o navegador não precisa de CORS.
{
	email {$ACME_EMAIL}
	# Opções globais de outros sistemas hospedados nesta VPS (ex.: o
	# on_demand_tls do Floruna). Um arquivo .global por sistema.
	import /etc/caddy/sites/*.global
}

# CSP e Permissions-Policy (snippets csp_site, csp_app e permissions).
import /etc/caddy/security-headers.caddy

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	import permissions

	handle /api/* {
		reverse_proxy api:5000
	}

	handle /webhook {
		reverse_proxy agent:8000
	}

	# Checagens de saúde de fora do servidor (monitoramento).
	handle /health/api {
		rewrite * /health
		reverse_proxy api:5000
	}
	handle /health/agent {
		rewrite * /health
		reverse_proxy agent:8000
	}

	handle /download/* {
		root * /srv/downloads
		uri strip_prefix /download
		header Cache-Control "no-cache"
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Content-Disposition "attachment"
		file_server
	}

	redir /app /app/ 308
	handle /app/* {
		import csp_app
		root * /srv/web
		# index.html e o bootstrap não podem ficar em cache, senão o app não atualiza.
		@nocache path /app/ /app/index.html /app/flutter_service_worker.js /app/flutter_bootstrap.js /app/version.json
		header @nocache Cache-Control "no-cache"
		try_files {path} /app/index.html
		file_server
	}

	handle {
		import csp_site
		root * /srv/web
		@pages path / *.html
		header @pages Cache-Control "no-cache"
		# A versão antiga do app ficava na raiz e registrava este service worker; o do Flutter
		# só se desregistra, então continua sendo servido aqui para limpar navegadores antigos.
		rewrite /flutter_service_worker.js /app/flutter_service_worker.js
		try_files {path} {path}.html
		file_server
	}
}

# Sites de outros sistemas hospedados nesta VPS, atrás deste mesmo Caddy.
# A pasta vem do host (EDGE_SITES_DIR no .env); sem ela fica vazia.
import /etc/caddy/sites/*.caddy
